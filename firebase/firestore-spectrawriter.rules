// =====================================================================================================================
// SPECTRA Writer · MORCEAU de règles Firestore — NE PAS coller seul dans la console (erreurs « Unexpected 'match' »).
// Pour la console : copier le fichier COMPLET firebase/firestore.rules (règles du site + ce bloc déjà inséré).
// Sinon, à AJOUTER au fichier de règles commun du site Studio Prism
// (dépôt Studio-Prism, firebase/firestore.rules), juste avant le bloc « ARCHITRAFIC », puis publier les règles.
//
// Même modèle que le cloud ARCHIPLAN (copie adaptée, préfixe sw au lieu de ap) :
//   swDocs/{id} (+ content/main)  fiche du document (nom, taille, aperçu texte, thème) + contenu JSON
//   swFolders/{id}                dossiers (pids : documents du dossier)
//   swShares/{cible}__{email}     partages par email (cible = id du document, ou F_ + id du dossier)
//   swGrants/{cible}__{uid}       accès par lien
//   swUsage/{uid}                 octets utilisés (quota imposé côté serveur)
//   swLibrary/{uid}               modèles personnels
// Quota : 10 Mo sans licence, 50 Mo avec licences/{uid}_spectrawriter active, 1 Go administrateur.
// Les fonctions isSignedIn(), isActiveUser(), isAdmin(), isActiveAdminProfile(), isString(), isEmail() existent déjà dans le fichier commun.
// Tant que ces règles ne sont pas publiées, SPECTRA Writer enregistre les documents sur l'appareil (rien n'est perdu).
//
// À créer aussi dans l'administration du site : le produit « spectrawriter » (products/spectrawriter, nom « SPECTRA Writer »),
// pour pouvoir attribuer des licences et des clés.
// =====================================================================================================================

    function swEmail() {
      return request.auth.token.email.lower();
    }

    function swVerified() {
      return request.auth.token.email_verified == true;
    }

    function swP(pid) {
      return /databases/$(database)/documents/swDocs/$(pid);
    }

    function swF(fid) {
      return /databases/$(database)/documents/swFolders/$(fid);
    }

    function swU(uid) {
      return /databases/$(database)/documents/swUsage/$(uid);
    }

    // Quota du compte uid (le propriétaire du stockage, pas forcément l'auteur de l'écriture)
    function swQuota(uid) {
      let u = get(/databases/$(database)/documents/users/$(uid)).data;
      let lp = /databases/$(database)/documents/licenses/$(uid + '_spectrawriter');
      return isActiveAdminProfile(u) ? 1000000000
        : (exists(lp) && get(lp).data.status == 'active'
           && (get(lp).data.get('expiresAt', null) == null || get(lp).data.expiresAt > request.time)) ? 50000000
        : 10000000;
    }

    // Le compteur du propriétaire a bien été mis à jour dans ce lot, de la variation de taille du projet pid
    function swUsageOk(owner, pid, delta) {
      let before = exists(swU(owner)) ? get(swU(owner)).data.bytes : 0;
      return delta == 0
        || (existsAfter(swU(owner)) && getAfter(swU(owner)).data.lastPid == pid
            && getAfter(swU(owner)).data.bytes == before + delta);
    }

    function swShareRole(key) {
      let sp = /databases/$(database)/documents/swShares/$(key + '__' + swEmail());
      return exists(sp) ? get(sp).data.role : '';
    }

    function swGrantOk(key, t) {
      let gp = /databases/$(database)/documents/swGrants/$(key + '__' + request.auth.uid);
      return t.get('linkMode', 'off') in ['view', 'edit'] && t.get('linkKey', '') != '' && exists(gp) && get(gp).data.key == t.linkKey;
    }

    // Droit d'un invité sur un dossier : 'edit', 'view' ou ''
    function swFolderRole(fid) {
      let f = get(swF(fid)).data;
      let r = swShareRole('F_' + fid);
      return !swVerified() ? '' : r != '' ? r : swGrantOk('F_' + fid, f) ? f.linkMode : '';
    }

    // Droit d'un invité sur un projet : directement, ou par le dossier (du même propriétaire) qui le contient
    function swGuestRole(pid, p) {
      let r = swShareRole(pid);
      let viaLink = swGrantOk(pid, p) ? p.linkMode : '';
      let viaFolder = p.get('folderId', '') != '' && exists(swF(p.folderId)) && get(swF(p.folderId)).data.ownerUid == p.ownerUid
                      ? swFolderRole(p.folderId) : '';
      return !swVerified() ? ''
        : (r == 'edit' || viaLink == 'edit' || viaFolder == 'edit') ? 'edit'
        : (r == 'view' || viaLink == 'view' || viaFolder == 'view') ? 'view' : '';
    }

    function swCanRead(pid, p) {
      return isSignedIn() && isActiveUser() && (p.ownerUid == request.auth.uid || swGuestRole(pid, p) in ['view', 'edit']);
    }

    function swCanEdit(pid, p) {
      return isSignedIn() && isActiveUser() && (p.ownerUid == request.auth.uid || swGuestRole(pid, p) == 'edit');
    }

    function swValidProject(d) {
      return d.keys().hasAll(['ownerUid', 'name', 'folderId', 'linkMode', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'name', 'folderId', 'size', 'preview', 'theme', 'words', 'tpl', 'pageSize',
                             'starred', 'linkMode', 'linkKey', 'linkToken', 'linkPw', 'createdAt', 'updatedAt', 'updatedBy', 'updatedByName'])
        && isString(d.name, 1, 120)
        && isString(d.folderId, 0, 40)
        && isString(d.get('ownerEmail', ''), 0, 160)
        && isString(d.get('ownerName', ''), 0, 160)
        && isString(d.get('updatedByName', ''), 0, 160)
        && isString(d.get('updatedBy', ''), 0, 128)
        && d.get('size', 0) is int && d.get('size', 0) >= 0 && d.get('size', 0) <= 1000000
        && isString(d.get('preview', ''), 0, 6000)
        && isString(d.get('theme', ''), 0, 40)
        && isString(d.get('tpl', ''), 0, 40)
        && isString(d.get('pageSize', ''), 0, 12)
        && d.get('words', 0) is int && d.get('words', 0) >= 0
        && d.get('starred', false) is bool
        && d.linkMode in ['off', 'view', 'edit']
        && isString(d.get('linkKey', ''), 0, 128)
        && isString(d.get('linkToken', ''), 0, 64)
        && d.get('linkPw', false) is bool
        && d.updatedAt == request.time
        // un projet rangé dans un dossier : dossier du même propriétaire (un ancien dossier disparu ne donne aucun accès)
        && (d.folderId == '' || !existsAfter(swF(d.folderId)) || getAfter(swF(d.folderId)).data.ownerUid == d.ownerUid);
    }

    match /swDocs/{pid} {
      allow get: if swCanRead(pid, resource.data);
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      // création : par le propriétaire, ou par un invité « Modification » d'un dossier partagé (le projet appartient alors au propriétaire du dossier)
      allow create: if isSignedIn() && isActiveUser()
                    && swValidProject(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && (request.resource.data.ownerUid == request.auth.uid
                        || (request.resource.data.folderId != '' && swFolderRole(request.resource.data.folderId) == 'edit'
                            && getAfter(swF(request.resource.data.folderId)).data.pids.hasAny([pid])))
                    && swUsageOk(request.resource.data.ownerUid, pid, request.resource.data.get('size', 0));
      allow update: if isSignedIn() && swValidProject(request.resource.data)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && ((resource.data.ownerUid == request.auth.uid && isActiveUser())
                        || (swCanEdit(pid, resource.data)
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['size', 'preview', 'theme', 'words', 'pageSize', 'updatedAt', 'updatedBy', 'updatedByName'])))
                    && swUsageOk(resource.data.ownerUid, pid, request.resource.data.get('size', 0) - resource.data.get('size', 0));
      // suppression : le propriétaire (l'application décrémente le compteur dans le même lot ; ne pas le faire ne pénalise que lui)
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /content/{cid} {
        allow get: if cid == 'main' && swCanRead(pid, get(swP(pid)).data);
        allow create, update: if cid == 'main'
                              && swCanEdit(pid, getAfter(swP(pid)).data)
                              && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
                              && request.resource.data.data is string
                              && request.resource.data.data.size() <= 1000000
                              // la taille déclarée sur la fiche (celle qui est comptée) correspond au contenu
                              && request.resource.data.data.size() <= getAfter(swP(pid)).data.get('size', 0) + 2048
                              && request.resource.data.updatedAt == request.time;
        allow delete: if isSignedIn() && (!exists(swP(pid)) || get(swP(pid)).data.ownerUid == request.auth.uid || isAdmin());
      }
    }

    match /swUsage/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      // écrit avec la fiche d'un projet (lastPid) : cohérence vérifiée des deux côtés ; jamais au-delà du quota (une baisse reste permise)
      allow create, update: if isSignedIn() && isActiveUser()
                            && request.resource.data.keys().hasOnly(['bytes', 'lastPid', 'updatedAt'])
                            && request.resource.data.bytes is int && request.resource.data.bytes >= 0
                            && isString(request.resource.data.lastPid, 0, 40)
                            && request.resource.data.updatedAt == request.time
                            && ((resource == null && request.resource.data.lastPid == '')
                                || request.resource.data.bytes <= (resource == null ? 0 : resource.data.bytes)
                                || request.resource.data.bytes <= swQuota(uid))
                            && (
                              // première création par le titulaire (somme de ses projets existants)
                              (resource == null && request.auth.uid == uid && request.resource.data.lastPid == '')
                              // sinon : la variation correspond exactement à la taille du projet lastPid écrit dans le même lot
                              || (request.resource.data.lastPid != ''
                                  && (existsAfter(swP(request.resource.data.lastPid))
                                      ? (getAfter(swP(request.resource.data.lastPid)).data.ownerUid == uid
                                         && request.resource.data.bytes - (resource == null ? 0 : resource.data.bytes)
                                            == getAfter(swP(request.resource.data.lastPid)).data.get('size', 0)
                                               - (exists(swP(request.resource.data.lastPid)) ? get(swP(request.resource.data.lastPid)).data.get('size', 0) : 0))
                                      : (exists(swP(request.resource.data.lastPid))
                                         && get(swP(request.resource.data.lastPid)).data.ownerUid == uid
                                         && request.auth.uid == uid
                                         && request.resource.data.bytes - (resource == null ? 0 : resource.data.bytes)
                                            == -get(swP(request.resource.data.lastPid)).data.get('size', 0))))
                            );
      // supprimé seulement vide, ou avec le profil du compte (suppression du compte, même lot)
      allow delete: if (isSignedIn() && request.auth.uid == uid
                    && (resource.data.bytes == 0 || !existsAfter(/databases/$(database)/documents/users/$(uid))))
                    || isAdmin();
    }

    function swValidFolder(d) {
      return d.keys().hasAll(['ownerUid', 'name', 'parentId', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['ownerUid', 'ownerEmail', 'ownerName', 'name', 'parentId', 'shared', 'pids', 'linkMode', 'linkKey', 'linkToken',
                             'linkPw', 'createdAt', 'updatedAt'])
        && isString(d.name, 1, 80)
        && isString(d.parentId, 0, 40)
        && isString(d.get('ownerEmail', ''), 0, 160)
        && isString(d.get('ownerName', ''), 0, 160)
        && d.get('shared', false) is bool
        && d.get('pids', []) is list && d.get('pids', []).size() <= 500
        && d.get('linkMode', 'off') in ['off', 'view', 'edit']
        && isString(d.get('linkKey', ''), 0, 128)
        && isString(d.get('linkToken', ''), 0, 64)
        && d.get('linkPw', false) is bool
        && d.updatedAt == request.time;
    }

    match /swFolders/{fid} {
      allow get: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || (isActiveUser() && swFolderRole(fid) in ['view', 'edit']));
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isActiveUser() && swValidFolder(request.resource.data)
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      // propriétaire : tout ; invité « Modification » : seulement la liste des projets (création d'un projet dans le dossier)
      allow update: if isSignedIn() && isActiveUser() && swValidFolder(request.resource.data)
                    && request.resource.data.ownerUid == resource.data.ownerUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && (resource.data.ownerUid == request.auth.uid
                        || (swFolderRole(fid) == 'edit'
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pids', 'updatedAt'])
                            && request.resource.data.get('pids', []).hasAll(resource.data.get('pids', []))));
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    function swValidShare(sid) {
      let d = request.resource.data;
      let folder = d.get('kind', 'doc') == 'folder';
      return d.keys().hasAll(['email', 'role', 'ownerUid', 'createdAt'])
        && d.keys().hasOnly(['kind', 'pid', 'fid', 'email', 'role', 'ownerUid', 'name', 'ownerName', 'createdAt'])
        && d.get('kind', 'doc') in ['doc', 'folder']
        && isEmail(d.email) && d.email == d.email.lower()
        && d.role in ['view', 'edit']
        && d.ownerUid == request.auth.uid
        && isString(d.get('name', ''), 0, 120)
        && isString(d.get('ownerName', ''), 0, 160)
        && (folder
            ? (!('pid' in d) && isString(d.get('fid', ''), 1, 60) && sid == 'F_' + d.fid + '__' + d.email
               && get(swF(d.fid)).data.ownerUid == request.auth.uid)
            : (!('fid' in d) && isString(d.get('pid', ''), 1, 60) && sid == d.pid + '__' + d.email
               && get(swP(d.pid)).data.ownerUid == request.auth.uid));
    }

    match /swShares/{sid} {
      allow get, list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.email == swEmail() || isAdmin());
      allow create: if isSignedIn() && isActiveUser() && swValidShare(sid) && request.resource.data.createdAt == request.time;
      allow update: if isSignedIn() && isActiveUser() && resource.data.ownerUid == request.auth.uid && swValidShare(sid);
      allow delete: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || resource.data.email == swEmail() || isAdmin());
    }

    function swValidGrant(gid) {
      let d = request.resource.data;
      let folder = d.get('kind', 'doc') == 'folder';
      let t = folder ? get(swF(d.get('fid', '-'))).data : get(swP(d.get('pid', '-'))).data;
      return d.keys().hasOnly(['kind', 'pid', 'fid', 'uid', 'key', 'createdAt'])
        && d.get('kind', 'doc') in ['doc', 'folder']
        && d.uid == request.auth.uid
        && (folder ? (!('pid' in d) && isString(d.get('fid', ''), 1, 60) && gid == 'F_' + d.fid + '__' + request.auth.uid)
                   : (!('fid' in d) && isString(d.get('pid', ''), 1, 60) && gid == d.pid + '__' + request.auth.uid))
        && isString(d.key, 1, 128)
        && d.createdAt == request.time
        && t.get('linkMode', 'off') in ['view', 'edit']
        && t.get('linkKey', '') == d.key;
    }

    match /swGrants/{gid} {
      allow get, list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && isActiveUser() && swVerified() && swValidGrant(gid);
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /swLibrary/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isActiveUser()
                            && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
                            && request.resource.data.data is string
                            && request.resource.data.data.size() <= 900000
                            && request.resource.data.updatedAt == request.time;
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }
